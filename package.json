{
  "name": "procureiq-frontend-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:host",
    "dev:host": "next dev procureiq-nextjs -p 8990",
    "dev:crypto": "next dev mfe-crypto -p 8991",
    "dev:auth": "next dev mfe-auth -p 8992",
    "dev:notifications": "next dev mfe-notifications -p 8993",
    "dev:email": "next dev mfe-email -p 8994",
    "dev:campaigns": "next dev mfe-campaigns -p 8995",
    "dev:fieldservice": "next dev mfe-fieldservice -p 8996",
    "dev:github": "next dev mfe-github -p 8997",
    "dev:jobs": "next dev mfe-jobs -p 8998",
    "build:host": "next build procureiq-nextjs",
    "build:crypto": "next build mfe-crypto",
    "build:auth": "next build mfe-auth",
    "build:notifications": "next build mfe-notifications",
    "build:email": "next build mfe-email",
    "build:campaigns": "next build mfe-campaigns",
    "build:fieldservice": "next build mfe-fieldservice",
    "build:github": "next build mfe-github",
    "build:jobs": "next build mfe-jobs",
    "build:all": "concurrently \"npm run build:host\" \"npm run build:crypto\" \"npm run build:auth\" \"npm run build:notifications\" \"npm run build:email\" \"npm run build:campaigns\" \"npm run build:fieldservice\" \"npm run build:github\" \"npm run build:jobs\"",
    "dev:all": "concurrently -k \"npm run dev:host\" \"npm run dev:crypto\" \"npm run dev:auth\" \"npm run dev:notifications\" \"npm run dev:email\" \"npm run dev:campaigns\" \"npm run dev:fieldservice\" \"npm run dev:github\" \"npm run dev:jobs\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.379.0",
    "next": "^14.2.3",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.1.1",
    "@storybook/addon-essentials": "^8.1.1",
    "@storybook/addon-interactions": "^8.1.1",
